{
  "name": "@mulmobridge/cli",
  "version": "1.0.1",
  "description": "Interactive CLI bridge for MulmoBridge — talk to MulmoClaude from your terminal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mulmobridge-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "license": "MIT",
  "author": "Receptron Team",
  "dependencies": {
    "@mulmobridge/client": "^1.1.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/bridges/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/bridges/cli"
  },
  "keywords": [
    "cli",
    "terminal",
    "mulmobridge",
    "chatbot",
    "bridge",
    "ai-agent",
    "mulmoclaude"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
