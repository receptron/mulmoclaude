{
  "name": "@mulmobridge/chat-service",
  "version": "1.2.0",
  "description": "Server-side chat service for MulmoBridge — socket.io + REST bridge to Claude Code agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "license": "MIT",
  "author": "Receptron Team",
  "dependencies": {
    "@mulmobridge/protocol": "^1.1.0"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "socket.io": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/chat-service#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/chat-service"
  },
  "keywords": [
    "mulmobridge",
    "chat-service",
    "socket.io",
    "express",
    "ai-agent",
    "server"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
