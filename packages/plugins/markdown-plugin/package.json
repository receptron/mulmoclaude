{
  "name": "@mulmoclaude/markdown-plugin",
  "version": "4.1.0",
  "description": "Full-fidelity markdown document plugin (presentDocument) — Marp slides, PDF export, AI image-fill — shared gui-chat-protocol plugin for MulmoClaude and MulmoTerminal.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepack": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "echo 'no in-package tests; presentDocument logic is covered by host integration tests'"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.4.0",
    "@mulmoclaude/common": "^1.2.0",
    "@mulmoclaude/markdown-utils": "^2.2.0",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.12",
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.16.1"
  },
  "peerDependencies": {
    "@mulmoclaude/core": "^4.8.1",
    "gui-chat-protocol": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mulmoclaude/core": "^4.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "gui-chat-protocol": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT",
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/plugins/markdown-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/plugins/markdown-plugin"
  },
  "keywords": [
    "markdown",
    "document",
    "mulmoclaude",
    "mulmoclaude-plugin",
    "gui-chat-protocol",
    "claude-code",
    "mulmoterminal"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
