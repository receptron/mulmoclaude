{
  "name": "@mulmoclaude/email-plugin",
  "version": "2.0.3",
  "description": "Generic IMAP/SMTP email runtime plugin for MulmoClaude. Gmail-default provider presets; works with any IMAP/SMTP server (Fastmail / iCloud / Outlook / …). Uses App Password auth (no OAuth in v1).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "peerDependencies": {
    "gui-chat-protocol": "^2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "gui-chat-protocol": "^2.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "zod": "^4.6.5"
  },
  "license": "MIT",
  "dependencies": {
    "imapflow": "^2.3.0",
    "mailparser": "^3.9.37",
    "nodemailer": "^10.0.16"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/plugins/email-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/plugins/email-plugin"
  },
  "keywords": [
    "email",
    "imap",
    "smtp",
    "mulmoclaude",
    "mulmoclaude-plugin",
    "gui-chat-protocol",
    "claude-code"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
