{
  "name": "@mulmobridge/mock-server",
  "version": "1.0.3",
  "description": "Mock MulmoClaude server for testing MulmoBridge bridges — no Claude API key needed",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mulmobridge-mock-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test",
    "start": "tsx src/index.ts"
  },
  "license": "MIT",
  "author": "Receptron Team",
  "dependencies": {
    "@mulmobridge/protocol": "^1.0.1",
    "express": "^5.1.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/mock-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/mock-server"
  },
  "keywords": [
    "mulmobridge",
    "mock-server",
    "testing",
    "socket.io",
    "bridge"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
