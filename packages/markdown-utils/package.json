{
  "name": "@mulmoclaude/markdown-utils",
  "version": "2.2.0",
  "description": "Browser-safe markdown / image rendering utilities shared by the MulmoClaude host and the markdown plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "license": "MIT",
  "author": "Receptron Team",
  "dependencies": {
    "@mulmoclaude/common": "^1.3.0",
    "dompurify": "^3.4.15",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.12"
  },
  "peerDependencies": {
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.16.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.17.2",
    "typescript": "^6.0.3",
    "vue": "^3.5.42"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/markdown-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/markdown-utils"
  },
  "keywords": [
    "mulmoclaude",
    "markdown",
    "rendering",
    "browser-safe"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
