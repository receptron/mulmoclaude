{
  "name": "@receptron/task-scheduler",
  "version": "1.0.3",
  "description": "Persistent task scheduler with catch-up — schedule recurring tasks, survive restarts, recover missed runs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "license": "MIT",
  "author": "Receptron Team",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/scheduler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/scheduler"
  },
  "keywords": [
    "scheduler",
    "task-scheduler",
    "cron",
    "recurring-tasks",
    "catch-up",
    "zero-dependency"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
