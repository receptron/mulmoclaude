{
  "name": "@mulmobridge/relay",
  "version": "1.0.5",
  "description": "Cloudflare Workers relay for MulmoBridge — receives webhooks, queues messages, forwards via WebSocket to MulmoClaude",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist",
    "src",
    "wrangler.toml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@mulmobridge/client": "^1.1.0",
    "@mulmoclaude/common": "^1.2.0"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/relay"
  },
  "keywords": [
    "mulmobridge",
    "cloudflare-workers",
    "relay",
    "webhook",
    "websocket",
    "offline-queue"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
