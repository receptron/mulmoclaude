{
  "name": "@mulmobridge/client",
  "version": "1.1.0",
  "description": "Socket.io client library for MulmoBridge — shared by all bridge implementations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./mime": {
      "types": "./dist/mime.d.ts",
      "import": "./dist/mime.js",
      "require": "./dist/mime.js",
      "default": "./dist/mime.js"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "import": "./dist/token.js",
      "require": "./dist/token.js",
      "default": "./dist/token.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/test_*.ts",
    "lint": "eslint src test"
  },
  "license": "MIT",
  "author": "Receptron Team",
  "dependencies": {
    "@mulmobridge/protocol": "^1.0.1",
    "@mulmoclaude/common": "^1.3.0",
    "socket.io-client": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/receptron/mulmoclaude/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoclaude.git",
    "directory": "packages/client"
  },
  "keywords": [
    "mulmobridge",
    "socket.io-client",
    "bridge",
    "chat",
    "ai-agent"
  ],
  "bugs": {
    "url": "https://github.com/receptron/mulmoclaude/issues"
  }
}
